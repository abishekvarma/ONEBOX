# ONEBOX local development configuration

MYSQL_DATABASE=onebox
MYSQL_USER=onebox
MYSQL_PASSWORD=onebox_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password

JWT_KEY=replace-with-a-random-32-character-secret
ONEBOX_AGENT_SECRET=replace-with-a-random-agent-secret
ONEBOX_EXECUTION_MODE=sandbox
EXPOSE_OTP_IN_DEVELOPMENT=true

PUBLIC_API_URL=http://localhost:5080
PUBLIC_AGENT_URL=http://127.0.0.1:8787
CORS_ORIGINS=http://localhost:5173
GOOGLE_API_KEY=
TMDB_API_KEY=
OTP_PROVIDER=development
OTP_RESEND_API_KEY=
OTP_FROM_EMAIL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Browser provider allowlist
ONEBOX_ALLOWED_HOSTS=in.bookmyshow.com,bookmyshow.com,www.irctc.co.in,irctc.co.in,contents.irctc.co.in,www.google.com,google.com

# Authorized payment gateway configuration
PAYMENTS_PHONEPE_CHECKOUT_URL=
PAYMENTS_RAZORPAY_CHECKOUT_URL=
PAYMENTS_PHONEPE_WEBHOOK_SECRET=
PAYMENTS_RAZORPAY_WEBHOOK_SECRET=

# ONEBOX platform fee
PAYMENTS_PLATFORM_FEE=20
PAYMENTS_PLATFORM_FEE_PERCENT=10
PAYMENTS_PLATFORM_FEE_MINIMUM=0
PAYMENTS_PLATFORM_FEE_MAXIMUM=99

# Admin
ADMIN_EMAILS=
